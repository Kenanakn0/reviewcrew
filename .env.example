# Copy to `.env` and adjust. Never commit `.env` or the private key.

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# --- GitHub App (see docs/github-app-setup.md) ---
# "Client ID" shown on the App's settings page (used as the JWT issuer).
GITHUB_APP_CLIENT_ID=Iv23liXXXXXXXXXXXXXX
# Path to the downloaded private key. Keep it outside the repository; use forward slashes.
GITHUB_PRIVATE_KEY_PATH=C:/path/outside/repo/reviewcrew.private-key.pem
# The same random string entered as "Webhook secret" in the App settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# Override only for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com
