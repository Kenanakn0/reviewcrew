# Copy to `.env` and adjust. Never commit `.env` or the private key.

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# --- GitHub App (see docs/github-app-setup.md) ---
# "Client ID" shown on the App's settings page (used as the JWT issuer).
GITHUB_APP_CLIENT_ID=Iv23liXXXXXXXXXXXXXX
# Path to the downloaded private key. Keep it outside the repository; use forward slashes.
GITHUB_PRIVATE_KEY_PATH=C:/path/outside/repo/reviewcrew.private-key.pem
# The same random string entered as "Webhook secret" in the App settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# Override only for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com

# --- LLM ---------------------------------------------------------------------------------
# Default: a free local model through Ollama's OpenAI-compatible API (see
# docs/local-llm.md). Start Ollama with a context of at least 16k tokens:
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve
LLM_PROVIDER=openai_compat
LLM_MODEL=qwen2.5-coder:7b
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# The same server as seen from inside Docker containers (docker compose).
OPENAI_COMPAT_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
# Ollama ignores the key; set one for hosted OpenAI-compatible APIs.
OPENAI_COMPAT_API_KEY=

# Optional alternative: Anthropic's Claude API (paid). Only needed with
# LLM_PROVIDER=anthropic; LLM_MODEL then defaults to claude-opus-5-5.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# low | medium | high | xhigh | max (Anthropic only; deeper reasoning costs more tokens)
LLM_EFFORT=high
# On a safety refusal, let the API retry on a fallback model (Anthropic only).
ANTHROPIC_REFUSAL_FALLBACK=true

# Limits sized for a 7B model on a desktop; with Claude they can be raised
# (e.g. LLM_MAX_CONCURRENCY=4, LLM_TIMEOUT_SECONDS=300, DIFF_MAX_TOKENS_PER_CHUNK=8000).
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2
# Simultaneous LLM calls per review (all agents share this limit).
LLM_MAX_CONCURRENCY=1

# --- Diff processing ---
# Upper bound on the (conservatively estimated) tokens of one chunk sent to an agent.
# Prompt + chunk + answer must fit the model's context window.
DIFF_MAX_TOKENS_PER_CHUNK=4000
# Files with more added + removed lines than this are skipped as too large.
DIFF_MAX_CHANGED_LINES_PER_FILE=1000
# Unchanged lines added around each hunk when the file's head content is available.
DIFF_CONTEXT_LINES=5

# --- Review ---
# Language of review comments: en | tr
REVIEW_LANGUAGE=en
# Agents to run, as a JSON list: security, performance, tests
REVIEW_AGENTS=["security", "performance", "tests"]
# Findings below this confidence (0-1) are hidden.
REVIEW_MIN_CONFIDENCE=0.5
# Inline comments per PR; further findings are listed in the summary.
REVIEW_MAX_INLINE_COMMENTS=20
# Per-agent deadline; unfinished chunks are reported as not reviewed.
REVIEW_AGENT_TIMEOUT_SECONDS=1800
# Tokens one PR may spend across all agents; further chunks are skipped and reported.
REVIEW_TOKEN_BUDGET=300000

# --- Queue (Redis + arq) ---
REDIS_URL=redis://localhost:6379/0
# How long a reviewed (repo, PR, head SHA) is remembered to suppress duplicates (seconds).
REVIEW_DEDUP_TTL_SECONDS=604800
REVIEW_JOB_TIMEOUT_SECONDS=3600
WORKER_MAX_JOBS=2
